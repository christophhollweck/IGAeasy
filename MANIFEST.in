prune IGAeasy/investigation_setups
prune IGAeasy/tests
prune benchmarks
prune build
prune dist
global-exclude __pycache__ *.py[cod]
exclude runner.py runner.bat setup.py
exclude tests/*.json tests/*.png

recursive-include tests *.py
recursive-include docs *.md
recursive-include docs/images *.png
recursive-include IGAeasy/examples *.md
